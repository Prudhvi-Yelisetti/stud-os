# Copy this file to .env and fill in whichever provider(s) you want to
# use for AI chat-completion features (task suggestions, etc). None of
# these are required to run Stud-OS -- semantic search always works
# without any of them (it uses a local embedding model, not an API).
#
# Only set the ones for providers you actually plan to use. Which
# provider each feature uses is chosen separately in Settings -> AI once
# its key is set here.
#
# You don't actually have to edit this file by hand: Settings -> AI has
# a "paste your key" field per provider that writes it into your real
# .env for you (never into the database) and picks it up immediately,
# no restart needed. Editing this file directly still works exactly the
# same as before -- pick whichever's more convenient.

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional override

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash       # optional override

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini            # optional override

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash    # deepseek-v4-pro is the higher-quality, pricier tier

MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest  # mistral-large-latest is the higher-quality, pricier tier

XAI_API_KEY=
# XAI_MODEL=grok-4

PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar              # sonar-pro / sonar-reasoning-pro for deeper, pricier answers
# Perplexity's models search the web live and cite sources -- a genuinely
# different flavor of answer from the rest of this list, worth knowing
# about if "ask your notes" answers ever need current outside context.

# Local models -- no API key needed, nothing leaves your machine, and
# there's no per-request cost. Just run the server and pick it in
# Settings; no line above needs to be uncommented for these two.
#
# Ollama (https://ollama.com): `ollama pull llama3.1` then `ollama serve`
# (usually already running as a background service after install).
# OLLAMA_MODEL=llama3.1                        # must match a model you've pulled
# OLLAMA_BASE_URL=http://localhost:11434/v1    # only if Ollama isn't on the default host/port

# LM Studio (https://lmstudio.ai): load a model in the app and start its
# local server (Developer tab -> Start Server). LM Studio serves whatever
# model is currently loaded regardless of the model name sent, so
# LMSTUDIO_MODEL rarely needs to change.
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_BASE_URL=http://localhost:1234/v1   # only if LM Studio isn't on the default port
